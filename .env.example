# -----------------------------------------------------------------------------
# WhatsQuery environment example
# -----------------------------------------------------------------------------

# Core app
NODE_ENV="development"
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-long-random-secret"
SUPER_ADMIN_EMAILS="admin@whatsquery.local"
DEMO_MODE="false"

# Database (self-hosted Supabase PostgreSQL on Contabo)
# VPS-host example. Replace ports and names with values reported by
# scripts/contabo-db-topology.sh. Use the pooler only when it is actually enabled.
DATABASE_URL="postgresql://whatsquery_app:replace-me@127.0.0.1:6543/whatsquery?connection_limit=10"
# Direct migration connection. Never expose PostgreSQL publicly just for Prisma.
DIRECT_URL="postgresql://whatsquery_app:replace-me@127.0.0.1:5432/whatsquery"

# Optional security / integrations
ENCRYPTION_KEY="replace-with-a-separate-long-random-secret"
INTEGRATION_CREDENTIAL_SECRET="replace-with-a-separate-long-random-secret"
INTEGRATION_WEBHOOK_SIGNING_KEY="replace-with-a-separate-long-random-secret"
REDIS_URL="redis://localhost:6379"
NEXT_PUBLIC_TURNSTILE_SITE_KEY="1x00000000000000000000AA"
TURNSTILE_SECRET_KEY="replace-with-turnstile-secret"
ALLOW_OTP_BYPASS="false"
ENABLE_DEBUG_ROUTES="true"
WHATSQUERY_BACKUP_RETENTION_DAYS="14"
# WHATSQUERY_BACKUP_ALERT_EMAIL="ops@yourdomain.com"
# WHATSQUERY_BACKUP_ALERT_WEBHOOK_URL="https://hooks.example.com/services/..."

# Voice product foundation
# Public subdomain hostname served by the shared Next.js app.
VOICE_APP_HOST="voice.whatsquery.com"
# Public HTTPS URL for the standalone receptionist surface.
VOICE_APP_URL="https://voice.whatsquery.com"
# Feature flag only. Keep false if the subdomain is not deployed yet.
VOICE_PRODUCT_ENABLED="true"
# Placeholder only. Leave as disabled until a provider integration is implemented.
VOICE_TELEPHONY_PROVIDER="disabled"
# Provider placeholders only. Do not set fake secrets.
VOICE_VAPI_API_KEY=""
VAPI_PRIVATE_API_KEY=
VAPI_PUBLIC_KEY=
VAPI_WEBHOOK_SECRET=
VAPI_EVENT_ENCRYPTION_KEY=
VAPI_ALLOWED_CIDRS=
VAPI_RECONCILIATION_INTERVAL_MINUTES=60
VAPI_SERVER_URL=https://voice.whatsquery.com/api/webhooks/vapi
VOICE_PUBLIC_APP_URL=https://voice.whatsquery.com
# Optional one-time bootstrap only. Use this temporarily to attach a phone number to the first VoiceAgent, then move the mapping into the DB.
VOICE_BOOTSTRAP_PHONE_NUMBER_ID=
VOICE_JOBS_SECRET=
VOICE_CALLING_ENABLED=false
VOICE_ERP_WRITE_ENABLED=false
VOICE_RESTAURANT_WORKFLOWS_ENABLED=false
VOICE_DEMO_ORG=
VOICE_TWILIO_ACCOUNT_SID=""
VOICE_TWILIO_AUTH_TOKEN=""
VOICE_TWILIO_PHONE_NUMBER=""
VOICE_TWILIO_WEBHOOK_SECRET=""
VOICE_TWILIO_CALLING_ENABLED=false
VOICE_TWILIO_TWIML_URL=
VOICE_OUTBOUND_CALLS_PER_MINUTE=10
VOICE_BLOCKED_DESTINATIONS=
VOICE_ASTERISK_CALLING_ENABLED=false
ASTERISK_ORIGINATE_URL=
ASTERISK_API_TOKEN=
ASTERISK_WEBHOOK_SECRET=
VOICE_CALENDAR_PROVIDER=""
# Google Calendar OAuth placeholders for future booking sync.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
VOICE_CRM_WEBHOOK_URL=""
VOICE_WHATSAPP_FOLLOW_UP_WEBHOOK_URL=""
VOICE_WHATSAPP_WEBHOOK_VERIFY_TOKEN=""
VOICE_WHATSAPP_SEND_ENABLED=false
VOICE_WHATSAPP_APP_SECRET=""

# Cloudflare R2 off-server PostgreSQL backups
# WHATSQUERY_BACKUP_R2_ENABLED="true"
# WHATSQUERY_BACKUP_R2_ACCOUNT_ID="your-cloudflare-account-id"
# WHATSQUERY_BACKUP_R2_ENDPOINT="https://your-cloudflare-account-id.r2.cloudflarestorage.com"
# WHATSQUERY_BACKUP_R2_BUCKET="whatsquery-backups"
# WHATSQUERY_BACKUP_R2_PREFIX="postgres"
# WHATSQUERY_BACKUP_R2_REGION="auto"
# WHATSQUERY_BACKUP_R2_RETENTION_DAYS="30"
# WHATSQUERY_BACKUP_R2_ACCESS_KEY_ID="REPLACE_WITH_R2_ACCESS_KEY_ID"
# WHATSQUERY_BACKUP_R2_SECRET_ACCESS_KEY="REPLACE_WITH_R2_SECRET_ACCESS_KEY"

# Email / OTP
RESEND_API_KEY="re_replace_me"
EMAIL_FROM="noreply@yourdomain.com"
RESEND_AUDIENCE_ID=""

# Stripe billing
STRIPE_SECRET_KEY="sk_test_replace_me"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_replace_me"
STRIPE_WEBHOOK_SECRET="whsec_replace_me"
STRIPE_STARTER_PRICE_ID="price_monthly_starter"
STRIPE_BUSINESS_PRICE_ID="price_monthly_business"
STRIPE_PRO_PRICE_ID="price_monthly_pro"
STRIPE_STARTER_YEARLY_PRICE_ID="price_yearly_starter"
STRIPE_BUSINESS_YEARLY_PRICE_ID="price_yearly_business"
STRIPE_PRO_YEARLY_PRICE_ID="price_yearly_pro"

# Storage
STORAGE_TYPE="local"
UPLOAD_DIR="./uploads"
# S3_ENDPOINT="https://your-s3-endpoint"
# S3_ACCESS_KEY="replace-me"
# S3_SECRET_KEY="replace-me"
# S3_BUCKET="whatsquery-uploads"

# Ecommerce APIs
DARAZ_API_BASE_URL="https://api.daraz.com/rest"
DARAZ_DEMO_MODE="true"
SHOPIFY_API_VERSION="2025-01"
WOOCOMMERCE_DEMO_MODE="true"
SHOPIFY_DEMO_MODE="true"
# SHOPIFY_API_KEY=""
# SHOPIFY_API_SECRET=""
# WOOCOMMERCE_CONSUMER_KEY=""
# WOOCOMMERCE_CONSUMER_SECRET=""
# DARAZ_APP_KEY=""
# DARAZ_APP_SECRET=""
# DARAZ_ACCESS_TOKEN=""

# Demo and admin seed guidance
SEED_ADMIN_EMAIL="admin@whatsquery.local"
SEED_ADMIN_PASSWORD="ChangeMe123!"
SEED_DEMO_EMAIL="admin@alsadiq.local"
SEED_DEMO_PASSWORD="Demo123!"
