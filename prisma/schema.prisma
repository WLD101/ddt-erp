// prisma/schema.prisma
//
// WhatsQuery Multi-Tenant Architecture
// Optimized for VPS Deployment with PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// -----------------------------------------------------------------------------
// Auth & Multi-Tenancy Core
// -----------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  phone         String?
  emailVerified DateTime?
  authStatus    String    @default("unverified") // unverified, verified
  verifiedAt    DateTime?
  image         String?
  password      String?
  isDemoUser    Boolean   @default(false)

  accounts Account[]
  sessions Session[]

  // ERP specific
  memberships   OrganizationUser[]
  auditLogs     AuditLog[]
  notifications Notification[]
  importJobs    ImportJob[]

  createdAt               DateTime                     @default(now())
  updatedAt               DateTime                     @updatedAt
  deletedAt               DateTime?
  Partner                 Partner?
  assignedLeads           Lead[]                       @relation("LeadAssignee")
  EmailLog                EmailLog[]
  assignedPackages        OrganizationPackage[]        @relation("PackageAssigner")
  approvedExports         ExportRequest[]              @relation("ExportApprover")
  requestedExports        ExportRequest[]              @relation("ExportRequester")
  securityProfile         UserSecurityProfile?
  recoveryCodes           RecoveryCode[]
  trustedDevices          TrustedDevice[]
  authChallenges          AuthChallenge[]
  securityEvents          SecurityEvent[]
  updatedSecurityPolicies OrganizationSecurityPolicy[] @relation("SecurityPolicyUpdater")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Invitation {
  id             String       @id @default(cuid())
  email          String
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  roleId         String
  role           Role         @relation(fields: [roleId], references: [id])
  token          String       @unique
  expires        DateTime
  acceptedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([token])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())

  @@index([email])
  @@index([token])
}

model OtpVerification {
  id           String    @id @default(cuid())
  email        String
  purpose      String // DEMO_SIGNUP, PAID_SIGNUP, PASSWORD_RESET
  payload      String?
  codeHash     String
  expiresAt    DateTime
  attemptCount Int       @default(0)
  maxAttempts  Int       @default(5)
  lastSentAt   DateTime
  verifiedAt   DateTime?
  createdAt    DateTime  @default(now())

  @@index([email, purpose])
  @@index([expiresAt])
}

// -----------------------------------------------------------------------------
// WhatsQuery Multi-Tenancy Models
// -----------------------------------------------------------------------------

model Organization {
  id      String  @id @default(cuid())
  name    String
  slug    String  @unique
  logoUrl String?

  // Business profile
  phone          String?
  email          String?
  address        String?
  city           String?
  country        String?
  currency       String  @default("USD")
  timezone       String  @default("UTC")
  taxLabel       String?
  industry       String? // textile, manufacturing, retail
  industryType   String?
  enabledModules String?

  isDemoTenant    Boolean   @default(false)
  lifecycleStatus String    @default("onboarding")
  accessStatus    String    @default("onboarding")
  demoExpiresAt   DateTime?
  graceEndsAt     DateTime?
  blockedAt       DateTime?
  activatedAt     DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  onboarding          OnboardingState?
  members             OrganizationUser[]
  subscription        Subscription?
  customers           Customer[]
  suppliers           Supplier[]
  products            Product[]
  categories          Category[]
  inventoryItems      InventoryItem[]
  stockMovements      StockMovement[]
  salesChannels       SalesChannel[]
  externalProductMaps ExternalProductMap[]
  externalOrderMaps   ExternalOrderMap[]
  salesInvoices       SalesInvoice[]
  purchaseInvoices    PurchaseInvoice[]
  expenses            Expense[]
  payments            Payment[]
  auditLogs           AuditLog[]
  roles               Role[]
  branches            Branch[]
  notifications       Notification[]
  ledgerEntries       LedgerEntry[]
  financialAccounts   FinancialAccount[]
  quotations          Quotation[]
  boms                BOM[]
  workOrders          WorkOrder[]
  workOrderMaterials  WorkOrderMaterial[]
  productionLogs      ProductionLog[]

  // Industry Specific Relations
  fabricLots       FabricLot[]
  yarnInventory    YarnInventory[]
  textileOrders    TextileOrder[]
  textileJobCards  TextileJobCard[]
  dyeingBatches    DyeingBatch[]
  stitchingBatches StitchingBatch[]

  machines      Machine[]
  qualityChecks QualityCheck[]

  posRegisters    POSRegister[]
  posSales        POSSale[]
  posReturns      POSReturn[]
  customerLoyalty CustomerLoyalty[]

  // Growth & Partnerships
  referralId                   String?                       @unique
  referral                     Referral?                     @relation(fields: [referralId], references: [id])
  Invitation                   Invitation[]
  AccountTransfer              AccountTransfer[]
  SalesReturn                  SalesReturn[]
  PurchaseReturn               PurchaseReturn[]
  organizationPackage          OrganizationPackage?
  exportRequests               ExportRequest[]
  securityPolicy               OrganizationSecurityPolicy?
  securityEvents               SecurityEvent[]
  trustedDevices               TrustedDevice[]
  authChallenges               AuthChallenge[]
  importJobs                   ImportJob[]
  SalesChannelSyncLog          SalesChannelSyncLog[]
  voiceBusinessProfile         VoiceBusinessProfile?
  voiceReceptionistSettings    VoiceReceptionistSettings?
  voiceLeads                   VoiceLead[]
  voiceCallLogs                VoiceCallLog[]
  voiceAgents                  VoiceAgent[]
  voiceKnowledgeBaseItems      VoiceKnowledgeBaseItem[]
  voiceIntegrationSettings     VoiceIntegrationSettings?
  VoiceBusinessTrainingProfile VoiceBusinessTrainingProfile?
  VoiceServiceItem             VoiceServiceItem[]
  VoiceBookingRules            VoiceBookingRules?
  VoiceOrderRules              VoiceOrderRules?
  VoiceHandoffRules            VoiceHandoffRules?
  VoiceAllowedActionPolicy     VoiceAllowedActionPolicy?
  VoiceActionAuditLog          VoiceActionAuditLog[]
  VoiceUsageMeter              VoiceUsageMeter?
  VoiceNotificationLog         VoiceNotificationLog[]
}

model OrganizationUser {
  id               String  @id @default(cuid())
  userId           String
  organizationId   String
  roleId           String
  assignedBranchId String?

  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role           Role         @relation(fields: [roleId], references: [id])
  assignedBranch Branch?      @relation(fields: [assignedBranchId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, organizationId])
}

model Role {
  id             String        @id @default(cuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name        String
  description String?
  memberships OrganizationUser[]
  permissions Permission[]
  Invitation  Invitation[]

  @@unique([name, organizationId])
  @@index([organizationId])
}

model Branch {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name    String
  code    String?
  address String?
  isMain  Boolean @default(false)

  memberships      OrganizationUser[]
  inventoryItems   InventoryItem[]
  salesInvoices    SalesInvoice[]
  purchaseInvoices PurchaseInvoice[]
  expenses         Expense[]
  payments         Payment[]
  stockMovements   StockMovement[]

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  LedgerEntry     LedgerEntry[]
  AccountTransfer AccountTransfer[]
  SalesReturn     SalesReturn[]
  PurchaseReturn  PurchaseReturn[]
  Quotation       Quotation[]

  // Industry specific
  posRegisters POSRegister[]

  @@unique([id, organizationId])
  @@index([organizationId])
}

model Permission {
  id       String  @id @default(cuid())
  name     String  @unique
  category String?
  roles    Role[]
}

model Subscription {
  id             String       @id @default(cuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  planId                  String
  status                  String
  paymentStatus           String    @default("payment_pending")
  accessStatus            String    @default("payment_pending")
  billingCycle            String    @default("MONTHLY")
  billingSource           String?
  manualPaymentMethod     String?
  manualPaymentReference  String?
  adminNotes              String?
  stripeCustomerId        String?
  stripeSubscriptionId    String?
  stripePriceId           String?
  stripeCheckoutSessionId String?
  cancelAtPeriodEnd       Boolean   @default(false)
  currentPeriodStart      DateTime
  currentPeriodEnd        DateTime
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  Package                 Package?  @relation(fields: [packageId], references: [id])
  packageId               String?
  activatedAt             DateTime?
  blockedAt               DateTime?
  expiredAt               DateTime?
  graceEndsAt             DateTime?
}

model UserSecurityProfile {
  id                         String    @id @default(cuid())
  userId                     String    @unique
  user                       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  totpEnabled                Boolean   @default(false)
  totpSecretEncrypted        String?
  pendingTotpSecretEncrypted String?
  recoveryCodeVersion        Int       @default(0)
  sessionVersion             Int       @default(1)
  lastRecoveryGeneratedAt    DateTime?
  passkeyEnabled             Boolean   @default(false)
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt
}

model RecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model TrustedDevice {
  id             String        @id @default(cuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tokenHash      String        @unique
  label          String?
  userAgent      String?
  ipAddress      String?
  lastUsedAt     DateTime?
  expiresAt      DateTime
  revokedAt      DateTime?
  createdAt      DateTime      @default(now())

  @@index([userId, expiresAt])
  @@index([organizationId])
}

model AuthChallenge {
  id                   String        @id @default(cuid())
  userId               String
  user                 User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId       String?
  organization         Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tokenHash            String        @unique
  purpose              String
  redirectTo           String?
  trustDeviceRequested Boolean       @default(false)
  verifiedAt           DateTime?
  completedAt          DateTime?
  expiresAt            DateTime
  createdAt            DateTime      @default(now())

  @@index([userId, purpose, expiresAt])
  @@index([organizationId])
}

model OrganizationSecurityPolicy {
  id                             String       @id @default(cuid())
  organizationId                 String       @unique
  organization                   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requireTwoFactorForAllUsers    Boolean      @default(false)
  requireTwoFactorForPrivileged  Boolean      @default(true)
  enforcePasskeysForAdmins       Boolean      @default(false)
  restrictConcurrentSessions     Boolean      @default(false)
  maxActiveDevices               Int?
  idleTimeoutMinutes             Int          @default(480)
  absoluteSessionLifetimeMinutes Int?
  staffIdleTimeoutMinutes        Int?
  managerIdleTimeoutMinutes      Int?
  accountantIdleTimeoutMinutes   Int?
  adminIdleTimeoutMinutes        Int?
  superAdminIdleTimeoutMinutes   Int?
  forcePasswordReset             Boolean      @default(false)
  emergencyLockEnabled           Boolean      @default(false)
  updatedById                    String?
  updatedBy                      User?        @relation("SecurityPolicyUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt                      DateTime     @default(now())
  updatedAt                      DateTime     @updatedAt
}

model SecurityEvent {
  id             String        @id @default(cuid())
  userId         String?
  user           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  type           String
  status         String        @default("info")
  ipAddress      String?
  userAgent      String?
  details        String?
  metadataJson   String?
  createdAt      DateTime      @default(now())

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@index([type, createdAt(sort: Desc)])
}

model StripeWebhookEvent {
  id             String   @id @default(cuid())
  eventId        String   @unique
  type           String
  organizationId String?
  status         String   @default("processed")
  payload        String?
  processedAt    DateTime @default(now())
  createdAt      DateTime @default(now())

  @@index([organizationId])
  @@index([processedAt])
}

model VoiceBusinessProfile {
  id                    String                @id @default(cuid())
  organizationId        String                @unique
  organization          Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  businessName          String
  industry              String?
  website               String?
  businessPhone         String?
  preferredLanguage     String                @default("AUTO_DETECT")
  openingHours          String?
  mainGoal              String
  fallbackContactMethod String?
  greetingMessage       String?
  voiceAgents           VoiceAgent[]
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  VoiceActionAuditLog   VoiceActionAuditLog[]

  @@index([organizationId])
}

model VoiceReceptionistSettings {
  id                 String       @id @default(cuid())
  organizationId     String       @unique
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  receptionistName   String       @default("WhatsQuery Receptionist")
  greetingMessage    String?
  fallbackMessage    String?
  languageMode       String       @default("AUTO_DETECT")
  businessHours      String?
  afterHoursBehavior String       @default("TAKE_MESSAGE")
  leadCaptureFields  String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@index([organizationId])
}

model VoiceLead {
  id                   String       @id @default(cuid())
  organizationId       String
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  voiceAgentId         String?
  voiceAgent           VoiceAgent?  @relation(fields: [voiceAgentId], references: [id], onDelete: SetNull)
  name                 String?
  phone                String?
  email                String?
  reasonForCall        String?
  status               String       @default("NEW")
  notes                String?
  source               String       @default("MANUAL")
  appointmentRequested Boolean      @default(false)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  @@unique([id, organizationId])
  @@index([organizationId, createdAt(sort: Desc)])
  @@index([voiceAgentId])
  @@index([source])
  @@index([status])
}

model VoiceCallLog {
  id                    String       @id @default(cuid())
  organizationId        String
  organization          Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  voiceAgentId          String?
  voiceAgent            VoiceAgent?  @relation(fields: [voiceAgentId], references: [id], onDelete: SetNull)
  callerNumber          String
  callStatus            String
  callDirection         String
  summary               String?
  transcriptPlaceholder String?

  // Vapi integration fields
  provider              String? // "vapi", "twilio", etc.
  providerCallId        String?
  providerPhoneNumberId String?
  providerAssistantId   String?
  endedReason           String?
  transcript            String?
  messagesJson          String?
  rawEventJson          String?
  recordingUrl          String?
  startedAt             DateTime?
  endedAt               DateTime?

  durationSeconds      Int?
  appointmentRequested Boolean  @default(false)
  isMissed             Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([id, organizationId])
  @@index([organizationId, createdAt(sort: Desc)])
  @@index([voiceAgentId])
  @@index([providerCallId])
  @@index([callStatus])
}

model VoiceKnowledgeBaseItem {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  question       String
  answer         String
  category       String?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([id, organizationId])
  @@index([organizationId, createdAt(sort: Desc)])
  @@index([isActive])
}

model VoiceIntegrationSettings {
  id                                  String       @id @default(cuid())
  organizationId                      String       @unique
  organization                        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vapiStatus                          String       @default("NOT_CONNECTED")
  vapiAssistantId                     String?
  vapiAssistantName                   String?
  vapiPhoneNumberId                   String?
  vapiWebhookUrl                      String?
  lastWebhookAt                       DateTime?
  lastWebhookType                     String?
  twilioStatus                        String       @default("NOT_CONNECTED")
  googleCalendarStatus                String       @default("NOT_CONNECTED")
  whatsappFollowUpStatus              String       @default("NOT_CONNECTED")
  whatsappNotificationsEnabled        Boolean      @default(false)
  staffWhatsAppNumber                 String?
  customerWhatsAppConfirmationEnabled Boolean      @default(false)
  whatsappProvider                    String?
  whatsappNotificationEvents          String?
  providerConfigNotes                 String?
  createdAt                           DateTime     @default(now())
  updatedAt                           DateTime     @updatedAt

  @@index([organizationId])
  @@index([vapiAssistantId])
  @@index([vapiPhoneNumberId])
}

model VoiceAgent {
  id                      String                        @id @default(cuid())
  organizationId          String
  organization            Organization                  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  businessProfileId       String?
  businessProfile         VoiceBusinessProfile?         @relation(fields: [businessProfileId], references: [id], onDelete: SetNull)
  trainingProfileId       String?
  trainingProfile         VoiceBusinessTrainingProfile? @relation(fields: [trainingProfileId], references: [id], onDelete: SetNull)
  name                    String
  role                    String                        @default("AI_RECEPTIONIST")
  languageMode            String                        @default("AUTO_DETECT")
  supportedLanguages      String?
  tone                    String                        @default("PROFESSIONAL")
  voicePersona            String?
  allowedTools            String?
  vapiAssistantId         String?
  vapiAssistantName       String?
  vapiPhoneNumberId       String?
  clientPublicPhoneNumber String?
  assignedVapiPhoneNumber String?
  forwardingStatus        String                        @default("DISABLED")
  forwardingInstructions  String?
  forwardingVerifiedAt    DateTime?
  isDefault               Boolean                       @default(false)
  isActive                Boolean                       @default(true)
  lastPromptSyncedAt      DateTime?
  createdAt               DateTime                      @default(now())
  updatedAt               DateTime                      @updatedAt
  callLogs                VoiceCallLog[]
  leads                   VoiceLead[]
  VoiceActionAuditLog     VoiceActionAuditLog[]

  @@unique([organizationId, name])
  @@index([organizationId, isDefault])
  @@index([organizationId, isActive])
  @@index([vapiAssistantId])
  @@index([vapiPhoneNumberId])
  @@index([businessProfileId])
}

model VoiceBusinessTrainingProfile {
  id                 String       @id @default(cuid())
  organizationId     String       @unique
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  locationCity       String?
  shortDescription   String?
  primaryLanguage    String       @default("AUTO_DETECT")
  supportedLanguages String?
  tone               String       @default("PROFESSIONAL")
  closingMessage     String?
  holidayClosures    String?
  lastPromptSyncedAt DateTime?
  voiceAgents        VoiceAgent[]
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@index([organizationId])
}

model VoiceServiceItem {
  id                String       @id @default(cuid())
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name              String
  category          String?
  description       String?
  pricePlaceholder  String?
  availability      String?
  notes             String?
  takeawayAvailable Boolean      @default(false)
  deliveryAvailable Boolean      @default(false)
  dineInAvailable   Boolean      @default(false)
  isActive          Boolean      @default(true)
  sortOrder         Int          @default(0)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@unique([id, organizationId])
  @@index([organizationId, category])
  @@index([organizationId, sortOrder])
}

model VoiceBookingRules {
  id                       String       @id @default(cuid())
  organizationId           String       @unique
  organization             Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  acceptsBookings          Boolean      @default(false)
  bookingType              String       @default("APPOINTMENT")
  bookingMode              String       @default("REQUEST_ONLY")
  requiredFields           String?
  maxPartySize             Int?
  bookingDurationMinutes   Int?
  advanceBookingLimitHours Int?
  confirmationMessage      String?
  fallbackMessage          String?
  createdAt                DateTime     @default(now())
  updatedAt                DateTime     @updatedAt

  @@index([organizationId])
}

model VoiceOrderRules {
  id                   String       @id @default(cuid())
  organizationId       String       @unique
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  acceptsOrderRequests Boolean      @default(false)
  orderMode            String       @default("REQUEST_ONLY")
  orderTypes           String?
  requiredFields       String?
  allergyDisclaimer    String?
  confirmationWording  String?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  @@index([organizationId])
}

model VoiceHandoffRules {
  id                           String       @id @default(cuid())
  organizationId               String       @unique
  organization                 Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fallbackPhone                String?
  fallbackEmail                String?
  staffNotificationPlaceholder String?
  handoffTriggers              String?
  allowLiveTransfer            Boolean      @default(false)
  transferPhoneNumber          String?
  transferRules                String?
  createdAt                    DateTime     @default(now())
  updatedAt                    DateTime     @updatedAt

  @@index([organizationId])
}

model VoiceAllowedActionPolicy {
  id                             String       @id @default(cuid())
  organizationId                 String       @unique
  organization                   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  allowedActions                 String?
  blockedActions                 String?
  erpWritesEnabled               Boolean      @default(false)
  backendAutoConfirmationEnabled Boolean      @default(false)
  createdAt                      DateTime     @default(now())
  updatedAt                      DateTime     @updatedAt

  @@index([organizationId])
}

model VoiceActionAuditLog {
  id                     String                @id @default(cuid())
  organizationId         String
  organization           Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  voiceBusinessProfileId String?
  voiceBusinessProfile   VoiceBusinessProfile? @relation(fields: [voiceBusinessProfileId], references: [id], onDelete: SetNull)
  voiceAgentId           String?
  voiceAgent             VoiceAgent?           @relation(fields: [voiceAgentId], references: [id], onDelete: SetNull)
  actorUserId            String?
  actorRole              String?
  action                 String
  status                 String                @default("SUCCESS")
  summary                String?
  metadataJson           String?
  createdAt              DateTime              @default(now())

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([voiceBusinessProfileId])
  @@index([voiceAgentId])
  @@index([action])
}

model VoiceWebhookEvent {
  id                     String    @id @default(cuid())
  organizationId         String?
  voiceBusinessProfileId String?
  voiceAgentId           String?
  provider               String    @default("vapi")
  providerEventId        String?
  providerCallId         String?
  providerAssistantId    String?
  providerPhoneNumberId  String?
  eventType              String
  status                 String    @default("received") // received, processing, processed, failed, ignored, mapping_failed
  rawPayloadJson         String?
  errorMessage           String?
  retryCount             Int       @default(0)
  receivedAt             DateTime  @default(now())
  processedAt            DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@index([providerCallId])
  @@index([providerAssistantId])
  @@index([providerPhoneNumberId])
  @@index([voiceAgentId])
  @@index([organizationId])
  @@index([eventType])
  @@index([status])
  @@index([createdAt])
}

model VoiceJob {
  id             String    @id @default(cuid())
  organizationId String?
  voiceAgentId   String?
  type           String
  status         String    @default("queued") // queued, processing, completed, failed, retrying
  payloadJson    String?
  attempts       Int       @default(0)
  maxAttempts    Int       @default(3)
  lastError      String?
  scheduledAt    DateTime  @default(now())
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status])
  @@index([type])
  @@index([scheduledAt])
  @@index([organizationId])
  @@index([voiceAgentId])
}

model VoiceUsageMeter {
