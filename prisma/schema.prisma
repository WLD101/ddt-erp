  providerKey         String
  actionKey           String?
  bucketKey           String
  windowStartedAt     DateTime
  windowEndsAt        DateTime
  count               Int                @default(0)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@unique([organizationId, bucketKey])
  @@index([organizationId, providerKey, windowStartedAt])
  @@index([windowEndsAt])
}

model IntegrationFieldMapping {
  id                  String            @id @default(cuid())
  organizationId      String
  tenantIntegrationId String
  tenantIntegration   TenantIntegration @relation(fields: [tenantIntegrationId], references: [id], onDelete: Cascade)
  externalEntity      String
  externalField       String
  internalEntity      String
  internalField       String
  direction           String
  transformation      String?
  defaultValue        String?
  isRequired          Boolean           @default(false)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@unique([tenantIntegrationId, externalEntity, externalField, internalEntity, internalField, direction])
  @@index([organizationId, tenantIntegrationId])
}

model IntegrationUsageRecord {
  id                  String            @id @default(cuid())
  organizationId      String
  organization        Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tenantIntegrationId String
  tenantIntegration   TenantIntegration @relation(fields: [tenantIntegrationId], references: [id], onDelete: Cascade)
  providerKey         String
  metric              String
  quantity            Int               @default(1)
  periodKey           String
  createdAt           DateTime          @default(now())

  @@index([organizationId, tenantIntegrationId, metric, periodKey])
}

model IntegrationOAuthState {
  id                    String       @id @default(cuid())
  organizationId        String
  organization          Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stateId               String       @unique
  userId                String
  providerKey           String
  redirectPath          String
  codeVerifierEncrypted String
  signature             String
  expiresAt             DateTime
  consumedAt            DateTime?
  createdAt             DateTime     @default(now())

  @@index([organizationId, providerKey, expiresAt])
}

model IntegrationWebhookEndpoint {
  id              String                       @id @default(cuid())
  organizationId  String
  organization    Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  providerKey     String
  url             String
  secretEncrypted String
  status          String                       @default("active")
  events          String?
  lastDeliveredAt DateTime?
  createdAt       DateTime                     @default(now())
  updatedAt       DateTime                     @updatedAt
  deliveries      IntegrationWebhookDelivery[]

  @@index([organizationId, providerKey])
}

model IntegrationWebhookDelivery {
  id                           String                     @id @default(cuid())
  organizationId               String
  organization                 Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  integrationWebhookEndpointId String
  integrationWebhookEndpoint   IntegrationWebhookEndpoint @relation(fields: [integrationWebhookEndpointId], references: [id], onDelete: Cascade)
  eventKey                     String
  deliveryId                   String                     @unique
  payloadRedacted              String?
  responseCode                 Int?
  responseBodyRedacted         String?
  status                       String                     @default("pending")
  attemptedAt                  DateTime?
  completedAt                  DateTime?
  createdAt                    DateTime                   @default(now())

  @@index([organizationId, status, createdAt])
}

// -----------------------------------------------------------------------------
// Voice OS Models (Phase 1 Additions)
// -----------------------------------------------------------------------------

model ConversationInsight {
  id               String  @id @default(cuid())
  callId           String  @unique
  summary          String
  intent           String
  sentiment        String
  bookingRequested Boolean @default(false)
  leadQualified    Boolean @default(false)
}

model AgentTemplate {
  id          String   @id @default(cuid())
  name        String?
  description String?
  industry    String // "Restaurant", "Clinic", "Real Estate"
  basePrompt  String
  config      String // Stored as JSON string
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model KnowledgeBase {
  id             String              @id @default(cuid())
  organizationId String?
  name           String?
  description    String?
  isGlobal       Boolean             @default(false)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  documents      KnowledgeDocument[]
}

model KnowledgeDocument {
  id              String        @id @default(cuid())
  knowledgeBaseId String
  knowledgeBase   KnowledgeBase @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)
  title           String
  content         String
  type            String // "FAQ", "Menu", "Policy", "Service"
  isGlobal        Boolean       @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model CostLedger {
  id        String   @id @default(cuid())
  tenantId  String
  callId    String?
  provider  String // "OpenAI", "ElevenLabs", "VAPI", "Twilio", "Nayatel"
  service   String // "TTS", "STT", "LLM", "Telephony"
  amount    Float
  createdAt DateTime @default(now())
}

model OnboardingTask {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  taskName       String // "Assign Phone Number", "Upload Knowledge", "Deploy Agent"
  status         String // "pending", "completed"
}
