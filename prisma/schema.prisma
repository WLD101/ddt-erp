model VoiceWhatsappConversation {
  id                   String                         @id @default(cuid())
  organizationId       String
  organization         Organization                   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  integrationId        String
  integration          VoiceWhatsappIntegration       @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  voiceAgentId         String?
  voiceAgent           VoiceAgent?                    @relation(fields: [voiceAgentId], references: [id], onDelete: SetNull)
  contactWaId          String
  contactName          String?
  status               String                         @default("OPEN")
  language             String?
  lastMessagePreview   String?
  lastMessageAt        DateTime?
  lastInboundAt        DateTime?
  lastOutboundAt       DateTime?
  handoffRequested     Boolean                        @default(false)
  leadCreated          Boolean                        @default(false)
  orderRequested       Boolean                        @default(false)
  appointmentRequested Boolean                        @default(false)
  metadataJson         String?
  createdAt            DateTime                       @default(now())
  updatedAt            DateTime                       @updatedAt
  messages             VoiceWhatsappMessage[]
  notificationLogs     VoiceWhatsappNotificationLog[]

  @@unique([integrationId, contactWaId])
  @@unique([id, organizationId])
  @@index([organizationId, lastMessageAt(sort: Desc)])
  @@index([voiceAgentId])
  @@index([status])
}

model VoiceWhatsappMessage {
  id                String                    @id @default(cuid())
  organizationId    String
  organization      Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  integrationId     String
  integration       VoiceWhatsappIntegration  @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  conversationId    String
  conversation      VoiceWhatsappConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  providerMessageId String?                   @unique
  direction         String
  messageType       String                    @default("text")
  body              String?
  status            String                    @default("RECEIVED")
  aiGenerated       Boolean                   @default(false)
  aiIntent          String?
  rawPayloadJson    String?
  errorMessage      String?
  sentAt            DateTime?
  deliveredAt       DateTime?
  readAt            DateTime?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  @@unique([id, organizationId])
  @@index([organizationId, createdAt(sort: Desc)])
  @@index([integrationId])
  @@index([conversationId, createdAt])
  @@index([direction])
  @@index([status])
}

model VoiceWhatsappTemplate {
  id                 String                    @id @default(cuid())
  organizationId     String
  organization       Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  integrationId      String?
  integration        VoiceWhatsappIntegration? @relation(fields: [integrationId], references: [id], onDelete: SetNull)
  name               String
  language           String                    @default("en")
  category           String?
  status             String                    @default("DRAFT")
  body               String
  providerTemplateId String?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt

  @@unique([organizationId, name, language])
  @@index([organizationId])
  @@index([integrationId])
  @@index([status])
}

model VoiceWhatsappNotificationLog {
  id             String                     @id @default(cuid())
  organizationId String
  organization   Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  integrationId  String?
  integration    VoiceWhatsappIntegration?  @relation(fields: [integrationId], references: [id], onDelete: SetNull)
  conversationId String?
  conversation   VoiceWhatsappConversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  eventType      String
  status         String                     @default("PENDING")
  destination    String?
  message        String?
  errorMessage   String?
  metadataJson   String?
  createdAt      DateTime                   @default(now())

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([integrationId])
  @@index([conversationId])
  @@index([status])
}

model VoiceJob {
  id                String    @id @default(cuid())
  organizationId    String?
  voiceAgentId      String?
  type              String
  status            String    @default("queued") // queued, processing, completed, failed, retrying, cancelled
  idempotencyKey    String?
  correlationId     String?
  entityType        String?
  entityId          String?
  payloadJson       String?
  workerVersion     String?   @map("worker_version")
  attempts          Int       @default(0)
  maxAttempts       Int       @default(3)
  lockedAt          DateTime?
  lockedBy          String?
  leaseExpiresAt    DateTime? @map("lease_expires_at")
  lastHeartbeatAt   DateTime? @map("last_heartbeat_at")
  timeoutAt         DateTime? @map("timeout_at")
  cancelRequestedAt DateTime? @map("cancel_requested_at")
  cancelledAt       DateTime? @map("cancelled_at")
  cancelReason      String?   @map("cancel_reason")
  deadLetteredAt    DateTime?
  failureCode       String?
  lastError         String?
  scheduledAt       DateTime  @default(now())
  startedAt         DateTime?
  completedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([type, idempotencyKey])
  @@index([status])
  @@index([type])
  @@index([scheduledAt])
  @@index([status, scheduledAt])
  @@index([status, leaseExpiresAt])
  @@index([organizationId])
  @@index([voiceAgentId])
  @@index([entityType, entityId])
}

model VoiceUsageMeter {
  id                             String       @id @default(cuid())
  organizationId                 String       @unique
  organization                   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  activeCalls                    Int          @default(0)
  maxActiveCalls                 Int          @default(1)
  callsToday                     Int          @default(0)
  callsThisMonth                 Int          @default(0)
  callMinutesToday               Int          @default(0)
  callMinutesThisMonth           Int          @default(0)
  callCostUsdToday               Float        @default(0)
  callCostUsdThisMonth           Float        @default(0)
  sipRoutingCostUsd              Float        @default(0)
  leadsThisMonth                 Int          @default(0)
  bookingRequestsThisMonth       Int          @default(0)
  orderRequestsThisMonth         Int          @default(0)
  whatsappNotificationsThisMonth Int          @default(0)
  webhookEventsToday             Int          @default(0)
  failedWebhookEventsToday       Int          @default(0)
  storageUsedBytes               BigInt       @default(0)
  resetPeriod                    DateTime     @default(now())
  createdAt                      DateTime     @default(now())
  updatedAt                      DateTime     @updatedAt

  @@index([organizationId])
}

model VoiceNotificationLog {
  id                String       @id @default(cuid())
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  voiceAgentId      String?
  type              String
  eventType         String
  recipient         String
  status            String       @default("queued") // queued, sent, failed, skipped
  provider          String?
  providerMessageId String?
  errorMessage      String?
  payloadJson       String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([organizationId])
  @@index([status])
  @@index([createdAt])
}

model TelecomActivationControl {
  id                       String    @id @default(cuid())
  scope                    String    @default("global")
  organizationId           String?
  providerId               String?
  mode                     String    @default("OFF")
  reason                   String?
  emergencyStopped         Boolean   @default(false)
  emergencyReason          String?
  tenantAllowlistJson      String?
  destinationAllowlistJson String?
  allowedCountryCodesJson  String?
  businessHoursJson        String?
  timezone                 String?
  maxMonthlySpendUsd       Float?
  maxDailySpendUsd         Float?
  maxEstimatedCallCostUsd  Float?
  maxCallsPerMinute        Int?
  maxCallsPerHour          Int?
  maxCallsPerDay           Int?
  maxConcurrentCalls       Int?
  maxCallDurationSec       Int?
  sandboxVerifiedAt        DateTime?
  sandboxVerifiedBy        String?
  sandboxVerificationJson  String?
  effectiveFrom            DateTime?
  activatedAt              DateTime?
  activatedBy              String?
  approvedAt               DateTime?
  approvedBy               String?
  expiresAt                DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  @@unique([scope, organizationId, providerId])
  @@index([mode, emergencyStopped])
  @@index([organizationId])
  @@index([providerId])
  @@index([effectiveFrom, expiresAt])
}

model TelecomAllowedDestination {
  id              String       @id @default(cuid())
  organizationId  String       @map("organization_id")
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  destinationE164 String       @map("destination_e164")
  label           String?
  status          String       @default("verified")
  verifiedAt      DateTime?    @map("verified_at")
  verifiedBy      String?      @map("verified_by")
  effectiveFrom   DateTime?    @map("effective_from")
  expiresAt       DateTime?    @map("expires_at")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  @@unique([organizationId, destinationE164])
  @@index([organizationId, status, expiresAt])
  @@index([organizationId, effectiveFrom, expiresAt])
  @@map("telecom_allowed_destinations")
}

model TelecomRateCard {
  id                  String               @id @default(cuid())
  providerId          String
  provider            Provider             @relation(fields: [providerId], references: [id], onDelete: Cascade)
  countryCode         String
  currency            String               @default("USD")
  costPerMinute       Decimal              @db.Decimal(12, 6)
  billingIncrementSec Int                  @default(60)
  minimumBillableSec  Int                  @default(60)
  connectionFee       Decimal?             @db.Decimal(12, 6)
  effectiveFrom       DateTime             @default(now())
  effectiveUntil      DateTime?
  source              String               @default("manual")
  snapshotJson        String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  usageLedger         TelecomUsageLedger[]

  @@index([providerId, countryCode, effectiveFrom])
  @@index([countryCode, effectiveFrom])
}

model TelecomUsageLedger {
  id                 String           @id @default(cuid())
  organizationId     String
  organization       Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  callId             String?          @unique
  call               Call?            @relation(fields: [callId], references: [id], onDelete: SetNull)
  providerId         String?
  provider           Provider?        @relation(fields: [providerId], references: [id], onDelete: SetNull)
  rateCardId         String?
  rateCard           TelecomRateCard? @relation(fields: [rateCardId], references: [id], onDelete: SetNull)
  providerCallId     String?
  destinationCountry String?
  durationSeconds    Int              @default(0)
  billableSeconds    Int              @default(0)
  costAmount         Decimal          @default(0) @db.Decimal(12, 6)
  currency           String           @default("USD")
  status             String           @default("estimated")
  periodStart        DateTime
  periodEnd          DateTime
  finalizedAt        DateTime?
  source             String           @default("call_event")
  metadataJson       String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([organizationId, periodStart, periodEnd])
  @@index([providerId, createdAt])
  @@index([status])
}

model TelecomBackfillCursor {
  id              String    @id @default(cuid())
  name            String    @unique
  status          String    @default("idle")
  lastProcessedId String?
  processedCount  Int       @default(0)
  errorCount      Int       @default(0)
  lastError       String?
  lockedAt        DateTime?
  lockedBy        String?
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status, updatedAt])
}

model TelecomOperationalAlert {
  id             String        @id @default(cuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  providerId     String?
  severity       String
  status         String        @default("open")
  code           String
  title          String
  message        String
  entityType     String?
  entityId       String?
  dedupeKey      String        @unique
  metadataJson   String?
  acknowledgedAt DateTime?
  resolvedAt     DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([status, severity, createdAt])
  @@index([organizationId, createdAt])
  @@index([providerId, createdAt])
}

// -----------------------------------------------------------------------------
// Core ERP Domain Models
// -----------------------------------------------------------------------------

model Customer {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name    String
  email   String?
  phone   String?
  address String?
  status  String  @default("ACTIVE")

  salesInvoices SalesInvoice[]
  payments      Payment[]
  posSales      POSSale[]
  loyalty       CustomerLoyalty?

  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  deletedAt DateTime?
  Quotation Quotation[]

  @@unique([id, organizationId])
  @@index([organizationId])
}

model Supplier {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name    String
  email   String?
  phone   String?
  address String?

  purchaseInvoices PurchaseInvoice[]
  payments         Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([id, organizationId])
  @@index([organizationId])
}

model Category {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name        String
  description String?
  products    Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([id, organizationId])
  @@index([organizationId])
}

model Product {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name       String
  sku        String?
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])
  unitType   String?
  unit       String?

  unitPrice         Float
  costPrice         Float
  lowStockThreshold Int   @default(10)

  inventoryItems       InventoryItem[]
  salesInvoiceItems    SalesInvoiceItem[]
  purchaseInvoiceItems PurchaseInvoiceItem[]

  // Manufacturing
  bom                BOM?
  bomItems           BOMItem[]
  workOrderMaterials WorkOrderMaterial[]

  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  deletedAt           DateTime?
  SalesReturnItem     SalesReturnItem[]
  PurchaseReturnItem  PurchaseReturnItem[]
  QuotationItem       QuotationItem[]
  externalProductMaps ExternalProductMap[]

  @@unique([id, organizationId])
  @@index([organizationId])
}

model InventoryItem {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  quantity Float   @default(0)
  location String?

  movements StockMovement[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@unique([organizationId, branchId, productId])
  @@unique([id, organizationId])
  @@index([organizationId])
  @@index([branchId])
}

model StockMovement {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  inventoryItemId String
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  type     String // "IN" or "OUT"
  quantity Float
  reason   String?

  createdAt DateTime @default(now())

  @@unique([id, organizationId])
  @@index([organizationId])
}

model SalesInvoice {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  invoiceNumber String
  status        InvoiceStatus @default(DRAFT)
  issueDate     DateTime      @default(now())
  dueDate       DateTime?

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  subtotal    Float   @default(0)
  discount    Float   @default(0)
  taxAmount   Float   @default(0)
  totalAmount Float
  notes       String?

  items    SalesInvoiceItem[]
  payments Payment[]
  returns  SalesReturn[]

  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  Quotation        Quotation?         @relation(fields: [quotationId], references: [id])
  quotationId      String?
  ExternalOrderMap ExternalOrderMap[]

  @@unique([id, organizationId])
  @@index([organizationId, createdAt(sort: Desc)])
}

model SalesInvoiceItem {
  id        String       @id @default(cuid())
  invoiceId String
  invoice   SalesInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id])

  quantity  Float
  unitPrice Float
  total     Float
}

model PurchaseInvoice {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id])

  invoiceNumber String
  status        InvoiceStatus @default(DRAFT)
  issueDate     DateTime      @default(now())
  dueDate       DateTime?

  subtotal    Float
  taxAmount   Float @default(0)
  totalAmount Float

  items    PurchaseInvoiceItem[]
  payments Payment[]

  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  branchId  String?
  branch    Branch?          @relation(fields: [branchId], references: [id])
  returns   PurchaseReturn[]

  @@unique([id, organizationId])
  @@index([organizationId, createdAt(sort: Desc)])
}

model PurchaseInvoiceItem {
  id                String          @id @default(cuid())
  purchaseInvoiceId String
  purchaseInvoice   PurchaseInvoice @relation(fields: [purchaseInvoiceId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id])

  quantity Float
  unitCost Float
  total    Float
}

model FinancialAccount {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name          String
  type          String // CASH, BANK, POS_DRAWER
  accountNumber String?
  bankName      String?

  currentBalance Float   @default(0)
  isDefault      Boolean @default(false)
  isActive       Boolean @default(true)

  payments      Payment[]
  expenses      Expense[]
  ledgerEntries LedgerEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([id, organizationId])
  @@index([organizationId])
}

model LedgerEntry {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  accountId String
  account   FinancialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  amount        Float
  balanceAfter  Float
  description   String
  referenceType String
  referenceId   String

  createdAt DateTime @default(now())

  @@unique([id, organizationId])
  @@index([organizationId])
}

model AuditLog {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  action     String
  entityType String
  entityId   String
  details    String?

  createdAt DateTime @default(now())

  @@unique([id, organizationId])
  @@index([organizationId, createdAt(sort: Desc)])
}

// -----------------------------------------------------------------------------
// TEXTILE INDUSTRY MODELS
// -----------------------------------------------------------------------------

model FabricLot {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  lotNumber   String
  fabricType  String // e.g. Cotton, Polyester
  gsm         Int?
  width       Float?
  color       String?
  totalMeters Float
  usedMeters  Float   @default(0)
  status      String  @default("AVAILABLE") // AVAILABLE, IN_PRODUCTION, FINISHED

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([id, organizationId])
  @@index([organizationId])
}

model YarnInventory {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  yarnType String
  count    String // e.g. 20/1, 30/1
  weightKg Float
  supplier String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([id, organizationId])
  @@index([organizationId])
}

model TextileOrder {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  orderNumber String
  customerId  String
  status      String @default("PENDING") // PENDING, DYEING, STITCHING, SHIPPED

  jobCards TextileJobCard[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([id, organizationId])
  @@index([organizationId])
}

model TextileJobCard {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  orderId String
  order   TextileOrder @relation(fields: [orderId], references: [id])

  process String // DYEING, STITCHING, PRINTING
  status  String @default("QUEUED")

  dyeingBatch    DyeingBatch?
  stitchingBatch StitchingBatch?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([id, organizationId])
  @@index([organizationId])
}

model DyeingBatch {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  jobCardId String         @unique
  jobCard   TextileJobCard @relation(fields: [jobCardId], references: [id])

  shadeCard String
  machineId String?

  createdAt DateTime @default(now())

  @@unique([id, organizationId])
  @@index([organizationId])
}

model StitchingBatch {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  jobCardId String         @unique
  jobCard   TextileJobCard @relation(fields: [jobCardId], references: [id])

  lineManager String?
  pieces      Int

  createdAt DateTime @default(now())

  @@unique([id, organizationId])
  @@index([organizationId])
}

// -----------------------------------------------------------------------------
// MANUFACTURING INDUSTRY MODELS
// -----------------------------------------------------------------------------

model BOM {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  productId String  @unique
  product   Product @relation(fields: [productId], references: [id])

  items      BOMItem[]
  workOrders WorkOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([id, organizationId])
  @@index([organizationId])
}

model BOMItem {
  id    String @id @default(cuid())
  bomId String
  bom   BOM    @relation(fields: [bomId], references: [id])

  productId String
  product   Product @relation(fields: [productId], references: [id])

  quantity Float

  @@index([bomId])
}

model WorkOrder {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  bomId String
  bom   BOM    @relation(fields: [bomId], references: [id])

  status   String @default("PLANNED") // PLANNED, IN_PROGRESS, COMPLETED
  quantity Float

  materials WorkOrderMaterial[]
  logs      ProductionLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([id, organizationId])
  @@index([organizationId])
}

model WorkOrderMaterial {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  workOrderId String
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id])

  quantity Float

  createdAt DateTime @default(now())

  @@unique([id, organizationId])
  @@index([organizationId])
  @@index([workOrderId])
}

model Machine {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name   String
  type   String
  status String @default("IDLE") // IDLE, RUNNING, MAINTENANCE

  createdAt DateTime @default(now())

  @@unique([id, organizationId])
  @@index([organizationId])
}

model ProductionLog {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

