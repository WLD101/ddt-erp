// prisma/schema.prisma
//
// WhatsQuery Multi-Tenant Architecture
// Optimized for VPS Deployment with PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// -----------------------------------------------------------------------------
// Auth & Multi-Tenancy Core
// -----------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  phone         String?
  emailVerified DateTime?
  authStatus    String    @default("unverified") // unverified, verified
  verifiedAt    DateTime?
  image         String?
  password      String?
  isDemoUser    Boolean   @default(false)

  accounts Account[]
  sessions Session[]

  // ERP specific
  memberships     OrganizationUser[]
  auditLogs       AuditLog[]
  notifications   Notification[]
  importJobs      ImportJob[]
  supportRequests SupportRequest[]

  createdAt               DateTime                     @default(now())
  updatedAt               DateTime                     @updatedAt
  deletedAt               DateTime?
  Partner                 Partner?
  assignedLeads           Lead[]                       @relation("LeadAssignee")
  EmailLog                EmailLog[]
  assignedPackages        OrganizationPackage[]        @relation("PackageAssigner")
  approvedExports         ExportRequest[]              @relation("ExportApprover")
  requestedExports        ExportRequest[]              @relation("ExportRequester")
  securityProfile         UserSecurityProfile?
  recoveryCodes           RecoveryCode[]
  trustedDevices          TrustedDevice[]
  authChallenges          AuthChallenge[]
  securityEvents          SecurityEvent[]
  updatedSecurityPolicies OrganizationSecurityPolicy[] @relation("SecurityPolicyUpdater")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Invitation {
  id             String       @id @default(cuid())
  email          String
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  roleId         String
  role           Role         @relation(fields: [roleId], references: [id])
  token          String       @unique
  expires        DateTime
  acceptedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([token])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())

  @@index([email])
  @@index([token])
}

model OtpVerification {
  id           String    @id @default(cuid())
  email        String
  purpose      String // DEMO_SIGNUP, PAID_SIGNUP, PASSWORD_RESET
  payload      String?
  codeHash     String
  expiresAt    DateTime
  attemptCount Int       @default(0)
  maxAttempts  Int       @default(5)
  lastSentAt   DateTime
  verifiedAt   DateTime?
  createdAt    DateTime  @default(now())

  @@index([email, purpose])
  @@index([expiresAt])
}

// -----------------------------------------------------------------------------
// Enums
// -----------------------------------------------------------------------------

enum TenantType {
  DEMO
  TRIAL
  PAID
  INTERNAL
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  SENT
  PARTIAL
  PAID
  OVERDUE
  CANCELLED
  RETURNED
  PARTIAL_RETURNED
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
  CONVERTED
}

// -----------------------------------------------------------------------------
// WhatsQuery Multi-Tenancy Models
// -----------------------------------------------------------------------------

model Organization {
  id      String  @id @default(cuid())
  name    String
  slug    String  @unique
  logoUrl String?

  // Business profile
  phone                String?
  email                String?
  address              String?
  city                 String?
  country              String?
  marketKey            String?
  currency             String  @default("USD")
  locale               String?
  timezone             String  @default("UTC")
  countryCode          String?
  taxLabel             String?
  pricingProfile       String?
  complianceProfile    String?
  marketRequiresReview Boolean @default(true)
  industry             String? // textile, manufacturing, retail
  industryType         String?
  industryProfileKey   String?
  enabledModules       String?

  tenantType      TenantType @default(DEMO)
  healthScore     Float?
  isDemoTenant    Boolean    @default(false)
  lifecycleStatus String     @default("onboarding")
  accessStatus    String     @default("onboarding")
  demoExpiresAt   DateTime?
  graceEndsAt     DateTime?
  blockedAt       DateTime?
  activatedAt     DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  walletBalance Decimal @default(0.00) @db.Decimal(10, 2)
  perMinuteRate Decimal @default(80.00) @db.Decimal(10, 2)

  onboarding                   OnboardingState?
  members                      OrganizationUser[]
  subscription                 Subscription?
  customers                    Customer[]
  suppliers                    Supplier[]
  products                     Product[]
  categories                   Category[]
  inventoryItems               InventoryItem[]
  stockMovements               StockMovement[]
  salesChannels                SalesChannel[]
  externalProductMaps          ExternalProductMap[]
  externalOrderMaps            ExternalOrderMap[]
  salesInvoices                SalesInvoice[]
  purchaseInvoices             PurchaseInvoice[]
  expenses                     Expense[]
  payments                     Payment[]
  auditLogs                    AuditLog[]
  roles                        Role[]
  branches                     Branch[]
  notifications                Notification[]
  ledgerEntries                LedgerEntry[]
  financialAccounts            FinancialAccount[]
  quotations                   Quotation[]
  boms                         BOM[]
  workOrders                   WorkOrder[]
  workOrderMaterials           WorkOrderMaterial[]
  productionLogs               ProductionLog[]
  integrationProviders         IntegrationProvider[]
  tenantIntegrations           TenantIntegration[]
  integrationSyncJobs          IntegrationSyncJob[]
  integrationEvents            IntegrationEvent[]
  integrationActionLogs        IntegrationActionLog[]
  integrationActionExecutions  IntegrationActionExecution[]
  integrationApprovalRequests  IntegrationApprovalRequest[]
  integrationUsageRecords      IntegrationUsageRecord[]
  integrationRateLimitCounters IntegrationRateLimitCounter[]
  integrationWebhookEndpoints  IntegrationWebhookEndpoint[]
  integrationWebhookDeliveries IntegrationWebhookDelivery[]
  integrationOAuthStates       IntegrationOAuthState[]

  // Industry Specific Relations
  fabricLots       FabricLot[]
  yarnInventory    YarnInventory[]
  textileOrders    TextileOrder[]
  textileJobCards  TextileJobCard[]
  dyeingBatches    DyeingBatch[]
  stitchingBatches StitchingBatch[]

  machines      Machine[]
  qualityChecks QualityCheck[]

  posRegisters    POSRegister[]
  posSales        POSSale[]
  posReturns      POSReturn[]
  customerLoyalty CustomerLoyalty[]

  // Growth & Partnerships
  referralId                    String?                        @unique
  referral                      Referral?                      @relation(fields: [referralId], references: [id])
  Invitation                    Invitation[]
  AccountTransfer               AccountTransfer[]
  SalesReturn                   SalesReturn[]
  PurchaseReturn                PurchaseReturn[]
  organizationPackage           OrganizationPackage?
  exportRequests                ExportRequest[]
  securityPolicy                OrganizationSecurityPolicy?
  securityEvents                SecurityEvent[]
  trustedDevices                TrustedDevice[]
  authChallenges                AuthChallenge[]
  importJobs                    ImportJob[]
  SalesChannelSyncLog           SalesChannelSyncLog[]
  voiceBusinessProfile          VoiceBusinessProfile?
  voiceReceptionistSettings     VoiceReceptionistSettings?
  voiceLeads                    VoiceLead[]
  voiceCallLogs                 VoiceCallLog[]
  voiceAgents                   VoiceAgent[]
  voiceKnowledgeBaseItems       VoiceKnowledgeBaseItem[]
  voiceIntegrationSettings      VoiceIntegrationSettings?
  VoiceBusinessTrainingProfile  VoiceBusinessTrainingProfile?
  VoiceServiceItem              VoiceServiceItem[]
  VoiceBookingRules             VoiceBookingRules?
  VoiceOrderRules               VoiceOrderRules?
  VoiceHandoffRules             VoiceHandoffRules?
  VoiceAllowedActionPolicy      VoiceAllowedActionPolicy?
  VoiceActionAuditLog           VoiceActionAuditLog[]
  VoiceUsageMeter               VoiceUsageMeter?
  VoiceNotificationLog          VoiceNotificationLog[]
  VoiceReservationRequest       VoiceReservationRequest[]
  VoiceOrderRequest             VoiceOrderRequest[]
  VoiceReviewItem               VoiceReviewItem[]
  VoiceReviewTransition         VoiceReviewTransition[]
  VoiceOutcomeLink              VoiceOutcomeLink[]
  VoiceBooking                  VoiceBooking[]
  voiceWhatsappIntegrations     VoiceWhatsappIntegration[]
  voiceWhatsappConversations    VoiceWhatsappConversation[]
  voiceWhatsappMessages         VoiceWhatsappMessage[]
  voiceWhatsappTemplates        VoiceWhatsappTemplate[]
  voiceWhatsappNotificationLogs VoiceWhatsappNotificationLog[]
  telecomPhoneNumbers           PhoneNumber[]
  telecomCallRoutes             CallRoute[]
  telecomCallLogs               CallLog[]
  telecomCalls                  Call[]
  telecomCallAttempts           CallAttempt[]
  telecomCallEvents             CallEvent[]
  telecomWebhookNonces          TelecomWebhookNonce[]
  telecomUsageLedger            TelecomUsageLedger[]
  telecomAlerts                 TelecomOperationalAlert[]
  telecomAllowedDestinations    TelecomAllowedDestination[]
  onboardingTasks               OnboardingTask[]
  supportRequests               SupportRequest[]
}

model OrganizationUser {
  id               String  @id @default(cuid())
  userId           String
  organizationId   String
  roleId           String
  assignedBranchId String?

  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role           Role         @relation(fields: [roleId], references: [id])
  assignedBranch Branch?      @relation(fields: [assignedBranchId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, organizationId])
}

model Role {
  id             String        @id @default(cuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name        String
  description String?
  memberships OrganizationUser[]
  permissions Permission[]
  Invitation  Invitation[]

  @@unique([name, organizationId])
  @@index([organizationId])
}

model Branch {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name    String
  code    String?
  address String?
  isMain  Boolean @default(false)

  memberships        OrganizationUser[]
  tenantIntegrations TenantIntegration[]
  inventoryItems     InventoryItem[]
  salesInvoices      SalesInvoice[]
  purchaseInvoices   PurchaseInvoice[]
  expenses           Expense[]
  payments           Payment[]
  stockMovements     StockMovement[]

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  LedgerEntry     LedgerEntry[]
  AccountTransfer AccountTransfer[]
  SalesReturn     SalesReturn[]
  PurchaseReturn  PurchaseReturn[]
  Quotation       Quotation[]

  // Industry specific
  posRegisters POSRegister[]

  @@unique([id, organizationId])
  @@index([organizationId])
}

model Permission {
  id       String  @id @default(cuid())
  name     String  @unique
  category String?
  roles    Role[]
}

model Subscription {
  id             String       @id @default(cuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  planId                  String
  status                  String
  paymentStatus           String    @default("payment_pending")
  accessStatus            String    @default("payment_pending")
  billingCycle            String    @default("MONTHLY")
  billingSource           String?
  manualPaymentMethod     String?
  manualPaymentReference  String?
  adminNotes              String?
  stripeCustomerId        String?
  stripeSubscriptionId    String?
  stripePriceId           String?
  stripeCheckoutSessionId String?
  cancelAtPeriodEnd       Boolean   @default(false)
  currentPeriodStart      DateTime
  currentPeriodEnd        DateTime
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  Package                 Package?  @relation(fields: [packageId], references: [id])
  packageId               String?
  activatedAt             DateTime?
  blockedAt               DateTime?
  expiredAt               DateTime?
  graceEndsAt             DateTime?
}

model UserSecurityProfile {
  id                         String    @id @default(cuid())
  userId                     String    @unique
  user                       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  totpEnabled                Boolean   @default(false)
  totpSecretEncrypted        String?
  pendingTotpSecretEncrypted String?
  recoveryCodeVersion        Int       @default(0)
  sessionVersion             Int       @default(1)
  lastRecoveryGeneratedAt    DateTime?
  passkeyEnabled             Boolean   @default(false)
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt
}

model RecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model TrustedDevice {
  id             String        @id @default(cuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tokenHash      String        @unique
  label          String?
  userAgent      String?
  ipAddress      String?
  lastUsedAt     DateTime?
  expiresAt      DateTime
  revokedAt      DateTime?
  createdAt      DateTime      @default(now())

  @@index([userId, expiresAt])
  @@index([organizationId])
}

model AuthChallenge {
  id                   String        @id @default(cuid())
  userId               String
  user                 User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId       String?
  organization         Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tokenHash            String        @unique
  purpose              String
  redirectTo           String?
  trustDeviceRequested Boolean       @default(false)
  verifiedAt           DateTime?
  completedAt          DateTime?
  expiresAt            DateTime
  createdAt            DateTime      @default(now())

  @@index([userId, purpose, expiresAt])
  @@index([organizationId])
}

model OrganizationSecurityPolicy {
  id                             String       @id @default(cuid())
  organizationId                 String       @unique
  organization                   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requireTwoFactorForAllUsers    Boolean      @default(false)
  requireTwoFactorForPrivileged  Boolean      @default(true)
  enforcePasskeysForAdmins       Boolean      @default(false)
  restrictConcurrentSessions     Boolean      @default(false)
  maxActiveDevices               Int?
  idleTimeoutMinutes             Int          @default(480)
  absoluteSessionLifetimeMinutes Int?
  staffIdleTimeoutMinutes        Int?
  managerIdleTimeoutMinutes      Int?
  accountantIdleTimeoutMinutes   Int?
  adminIdleTimeoutMinutes        Int?
  superAdminIdleTimeoutMinutes   Int?
  forcePasswordReset             Boolean      @default(false)
  emergencyLockEnabled           Boolean      @default(false)
  updatedById                    String?
  updatedBy                      User?        @relation("SecurityPolicyUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt                      DateTime     @default(now())
  updatedAt                      DateTime     @updatedAt
}

model SecurityEvent {
  id             String        @id @default(cuid())
  userId         String?
  user           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  type           String
  status         String        @default("info")
  ipAddress      String?
  userAgent      String?
  details        String?
  metadataJson   String?
  createdAt      DateTime      @default(now())

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@index([type, createdAt(sort: Desc)])
}

model StripeWebhookEvent {
  id             String   @id @default(cuid())
  eventId        String   @unique
  type           String
  organizationId String?
  status         String   @default("processed")
  payload        String?
  processedAt    DateTime @default(now())
  createdAt      DateTime @default(now())

  @@index([organizationId])
  @@index([processedAt])
}

model VoiceBusinessProfile {
  id                    String                @id @default(cuid())
  organizationId        String                @unique
  organization          Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  businessName          String
  industry              String?
  website               String?
  businessPhone         String?
  preferredLanguage     String                @default("AUTO_DETECT")
  openingHours          String?
  mainGoal              String
  fallbackContactMethod String?
  greetingMessage       String?
  voiceAgents           VoiceAgent[]
  callLogs              VoiceCallLog[]
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  VoiceActionAuditLog   VoiceActionAuditLog[]

  @@index([organizationId])
}

model VoiceReceptionistSettings {
  id                         String       @id @default(cuid())
  organizationId             String       @unique
  organization               Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  receptionistName           String       @default("WhatsQuery Receptionist")
  greetingMessage            String?
  fallbackMessage            String?
  languageMode               String       @default("AUTO_DETECT")
  businessHours              String?
  afterHoursBehavior         String       @default("TAKE_MESSAGE")
  capacityMode               String       @default("direct_ai") // direct_ai, queue_then_ai, fallback_to_staff, take_message, voicemail_callback
  leadCaptureFields          String?
  recordingEnabled           Boolean      @default(false)
  recordingDisclosureEnabled Boolean      @default(true)
  recordingDisclosureType    String       @default("verbal")
  recordingDisclosureText    String?
  transcriptionEnabled       Boolean      @default(false)
  recordingRetentionDays     Int          @default(30)
  transcriptRetentionDays    Int          @default(30)
  allowRecordingPlayback     Boolean      @default(false)
  allowTranscriptAccess      Boolean      @default(false)
  createdAt                  DateTime     @default(now())
  updatedAt                  DateTime     @updatedAt

  @@index([organizationId])
}

model VoiceLead {
  id                   String       @id @default(cuid())
  organizationId       String
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  voiceAgentId         String?
  voiceAgent           VoiceAgent?  @relation(fields: [voiceAgentId], references: [id], onDelete: SetNull)
  name                 String?
  phone                String?
  email                String?
  reasonForCall        String?
  status               String       @default("NEW")
  notes                String?
  source               String       @default("MANUAL")
  appointmentRequested Boolean      @default(false)
  providerCallId       String?
  outcomeKey           String?      @unique
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  @@unique([id, organizationId])
  @@index([organizationId, createdAt(sort: Desc)])
  @@index([voiceAgentId])
  @@index([providerCallId])
  @@index([source])
  @@index([status])
}

model VoiceReservationRequest {
  id              String       @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  voiceAgentId    String?
  voiceAgent      VoiceAgent?  @relation(fields: [voiceAgentId], references: [id], onDelete: SetNull)
  customerName    String?
  customerPhone   String?
  partySize       Int?
  requestedTime   DateTime?
  specialRequests String?
  status          String       @default("needs_staff_review") // requested, needs_staff_review, confirmed, rejected
  providerCallId  String?
  outcomeKey      String?      @unique
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([voiceAgentId])
  @@index([providerCallId])
  @@index([status])
}

model VoiceOrderRequest {
  id               String       @id @default(cuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  voiceAgentId     String?
  voiceAgent       VoiceAgent?  @relation(fields: [voiceAgentId], references: [id], onDelete: SetNull)
  customerName     String?
  customerPhone    String?
  customerAddress  String?
  orderDetailsText String
  totalEstimated   Float?
  status           String       @default("needs_staff_review") // requested, needs_staff_review, confirmed, rejected
  providerCallId   String?
  outcomeKey       String?      @unique
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([voiceAgentId])
  @@index([providerCallId])
  @@index([status])
}

model VoiceReviewItem {
  id                   String       @id @default(cuid())
  organizationId       String
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branchId             String
  sourceType           String
  sourceId             String
  requestType          String
  status               String       @default("captured")
  version              Int          @default(1)
  providerCallId       String?
  voiceAgentId         String?
  marketKey            String
  currency             String
  timezone             String
  customerSnapshotJson String?
  confirmedFieldsJson  String?
  inferredFieldsJson   String?
  unresolvedFieldsJson String?
  validationErrorsJson String?
  proposedActionJson   String?
  lastReason           String?
  assignedToUserId     String?
  approvedByUserId     String?
  idempotencyKey       String?      @unique
  completedAt          DateTime?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  @@unique([organizationId, sourceType, sourceId])
  @@index([organizationId, branchId, status, createdAt(sort: Desc)])
  @@index([organizationId, requestType, status])
}

model VoiceReviewTransition {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  reviewItemId   String
  branchId       String
  actorUserId    String?
  actorRole      String?
  previousStatus String?
  newStatus      String
  reason         String?
  providerCallId String?
  requestId      String
  metadataJson   String?
  createdAt      DateTime     @default(now())

  @@index([organizationId, reviewItemId, createdAt(sort: Desc)])
  @@index([organizationId, branchId, createdAt(sort: Desc)])
}

model VoiceOutcomeLink {
  id              String       @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branchId        String
  reviewItemId    String?
  sourceType      String
  sourceId        String
  outcomeType     String
  outcomeId       String?
  customerId      String?
  providerCallId  String?
  approvingUserId String?
  idempotencyKey  String       @unique
  metadataJson    String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([organizationId, sourceType, sourceId])
  @@index([organizationId, outcomeType, outcomeId])
}

model VoiceBooking {
  id                    String       @id @default(cuid())
  organizationId        String
  organization          Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branchId              String
  customerId            String?
  sourceReviewItemId    String?
  sourceRequestId       String?
  providerCallId        String?
  bookingType           String       @default("APPOINTMENT")
  status                String       @default("CONFIRMED")
  scheduledStartAt      DateTime
  scheduledEndAt        DateTime?
  timezone              String
  customerNameSnapshot  String?
  customerPhoneSnapshot String?
  notes                 String?
  idempotencyKey        String       @unique
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  @@index([organizationId, branchId, scheduledStartAt])
  @@index([organizationId, sourceRequestId])
  @@index([organizationId, status])
}

model VoiceCallLog {
  id                     String                @id @default(cuid())
  organizationId         String
  organization           Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  voiceBusinessProfileId String?
  voiceBusinessProfile   VoiceBusinessProfile? @relation(fields: [voiceBusinessProfileId], references: [id], onDelete: SetNull)
  voiceAgentId           String?
  voiceAgent             VoiceAgent?           @relation(fields: [voiceAgentId], references: [id], onDelete: SetNull)
  callerNumber           String
  callStatus             String
  callDirection          String
  summary                String?
  transcriptPlaceholder  String?

  // Vapi integration fields
  provider                       String? // "vapi", "twilio", etc.
  providerCallId                 String?
  externalCallKey                String?   @unique
  providerPhoneNumberId          String?
  providerAssistantId            String?
  providerStatus                 String?
  endedReason                    String?
  callOutcome                    String?
  fromNumberMasked               String?
  toNumberMasked                 String?
  transcript                     String?
  messagesJson                   String?
  rawEventJson                   String?
  recordingUrl                   String?
  recordingDisclosureStatus      String    @default("disabled")
  recordingDisclosureType        String?
  recordingDisclosureCompletedAt DateTime?
  recordingDeletedAt             DateTime?
  transcriptDeletedAt            DateTime?
  privacyPolicySnapshot          String?
  startedAt                      DateTime?
  ringingAt                      DateTime?
  answeredAt                     DateTime?
  endedAt                        DateTime?
  lastEventAt                    DateTime?
  callerCountry                  String?
  callerRegion                   String?
  callerCity                     String?
  callerTimezone                 String?
  callerNumberCountryCode        String?
  usageMetricsSource             String?

  durationSeconds               Int?
  totalDurationSeconds          Int?
  ringDurationSeconds           Int?
  conversationDurationSeconds   Int?
  billableDurationSeconds       Int?
  costUsd                       Float?
  providerActualCostUsd         Float?
  providerEstimatedCostUsd      Float?
  customerBillableCost          Float?
  billingCurrency               String?
  costBreakdownJson             String?
