  requestedBy       User         @relation("ExportRequester", fields: [requestedById], references: [id])
  approvedById      String?
  approvedBy        User?        @relation("ExportApprover", fields: [approvedById], references: [id])
  status            String
  scope             String?
  approvedAt        DateTime?
  generatedAt       DateTime?
  downloadTokenHash String?
  downloadExpiresAt DateTime?
  createdAt         DateTime     @default(now())

  @@index([organizationId])
}

model OrganizationPackage {
  id                 String       @id @default(cuid())
  organizationId     String       @unique
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  packageId          String
  package            Package      @relation(fields: [packageId], references: [id])
  assignedById       String?
  assignedBy         User?        @relation("PackageAssigner", fields: [assignedById], references: [id])
  customUserLimit    Int?
  customBranchLimit  Int?
  customPackageName  String?
  customPrice        Float?
  customBillingCycle String?
  customExpiryDate   DateTime?
  isCustomPackage    Boolean      @default(false)
  customFeatureJson  String?
  assignedAt         DateTime     @default(now())
}

model Package {
  id           String   @id @default(cuid())
  name         String
  productType  String   @default("ERP")
  businessSize String?
  userLimit    Int      @default(1)
  featureJson  String   @default("{}")
  isCustom     Boolean  @default(false)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  subscriptions Subscription[]
  assignments   OrganizationPackage[]
}

model ExternalProductMap {
  id                String       @id @default(cuid())
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  salesChannelId    String?
  productId         String
  product           Product      @relation(fields: [productId], references: [id])
  externalProductId String?
  externalVariantId String?
  externalSku       String?
  externalTitle     String?
  syncStatus        String?
  metadata          String?
  lastSyncedAt      DateTime?
  createdAt         DateTime     @default(now())

  @@index([organizationId])
}

model ExternalOrderMap {
  id                  String        @id @default(cuid())
  organizationId      String
  organization        Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  salesChannelId      String?
  salesInvoiceId      String?
  salesInvoice        SalesInvoice? @relation(fields: [salesInvoiceId], references: [id])
  externalOrderId     String?
  externalOrderNumber String?
  externalCustomerId  String?
  externalPaymentId   String?
  externalStatus      String?
  paymentStatus       String?
  metadata            String?
  lastSyncedAt        DateTime?
  createdAt           DateTime      @default(now())

  @@index([organizationId])
}

model AccountTransfer {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branchId       String
  branch         Branch       @relation(fields: [branchId], references: [id])
  createdAt      DateTime     @default(now())

  @@unique([id, organizationId])
}

model Expense {
  id             String           @id @default(cuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branchId       String
  branch         Branch           @relation(fields: [branchId], references: [id])
  accountId      String
  account        FinancialAccount @relation(fields: [accountId], references: [id])
  amount         Float
  description    String?
  category       String?
  date           DateTime         @default(now())
  createdAt      DateTime         @default(now())

  @@unique([id, organizationId])
}

model Notification {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String?
  user           User?        @relation(fields: [userId], references: [id], onDelete: Cascade)

  type       String
  severity   String    @default("INFO")
  title      String
  message    String
  actionUrl  String?
  entityType String?
  entityId   String?
  metadata   String?
  isRead     Boolean   @default(false)
  readAt     DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([userId])
}

model SalesChannelSyncLog {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  salesChannelId String?
  direction      String?
  entityType     String?
  status         String?
  message        String?
  metadata       String?
  startedAt      DateTime?
  finishedAt     DateTime?
  createdAt      DateTime     @default(now())

  @@index([organizationId])
}

model PlatformAuditLog {
  id         String   @id @default(cuid())
  actorId    String
  action     String
  entityType String
  entityId   String
  details    String?
  createdAt  DateTime @default(now())
}
