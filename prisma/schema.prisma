model VoiceNotificationLog {
  id                String       @id @default(cuid())
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  voiceAgentId      String?
  type              String
  eventType         String
  recipient         String
  status            String       @default("queued") // queued, sent, failed, skipped
  provider          String?
  providerMessageId String?
  errorMessage      String?
  payloadJson       String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([organizationId])
  @@index([status])
  @@index([createdAt])
}

// -----------------------------------------------------------------------------
// Core ERP Domain Models
// -----------------------------------------------------------------------------

model Customer {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name    String
  email   String?
  phone   String?
  address String?
  status  String  @default("ACTIVE")

  salesInvoices SalesInvoice[]
  payments      Payment[]
  posSales      POSSale[]
  loyalty       CustomerLoyalty?

  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  deletedAt DateTime?
  Quotation Quotation[]

  @@unique([id, organizationId])
  @@index([organizationId])
}

model Supplier {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name    String
  email   String?
  phone   String?
  address String?

  purchaseInvoices PurchaseInvoice[]
  payments         Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([id, organizationId])
  @@index([organizationId])
}

model Category {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name        String
  description String?
  products    Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([id, organizationId])
  @@index([organizationId])
}

model Product {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name       String
  sku        String?
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])
  unitType   String?
  unit       String?

  unitPrice         Float
  costPrice         Float
  lowStockThreshold Int   @default(10)

  inventoryItems       InventoryItem[]
  salesInvoiceItems    SalesInvoiceItem[]
  purchaseInvoiceItems PurchaseInvoiceItem[]

  // Manufacturing
  bom                BOM?
  bomItems           BOMItem[]
  workOrderMaterials WorkOrderMaterial[]

  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  deletedAt           DateTime?
  SalesReturnItem     SalesReturnItem[]
  PurchaseReturnItem  PurchaseReturnItem[]
  QuotationItem       QuotationItem[]
  externalProductMaps ExternalProductMap[]

  @@unique([id, organizationId])
  @@index([organizationId])
}

model InventoryItem {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  quantity Float   @default(0)
  location String?

  movements StockMovement[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@unique([organizationId, branchId, productId])
  @@unique([id, organizationId])
  @@index([organizationId])
  @@index([branchId])
}

model StockMovement {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  inventoryItemId String
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  type     String // "IN" or "OUT"
  quantity Float
  reason   String?

  createdAt DateTime @default(now())

  @@unique([id, organizationId])
  @@index([organizationId])
}

model SalesInvoice {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  invoiceNumber String
  status        String    @default("DRAFT")
  date          DateTime  @default(now())
  dueDate       DateTime?

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  subtotal    Float   @default(0)
  discount    Float   @default(0)
  taxAmount   Float   @default(0)
  totalAmount Float
  notes       String?

  items    SalesInvoiceItem[]
  payments Payment[]
  returns  SalesReturn[]

  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  Quotation        Quotation?         @relation(fields: [quotationId], references: [id])
  quotationId      String?
  ExternalOrderMap ExternalOrderMap[]

  @@unique([id, organizationId])
  @@index([organizationId, createdAt(sort: Desc)])
}

model SalesInvoiceItem {
  id        String       @id @default(cuid())
  invoiceId String
  invoice   SalesInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id])

  quantity  Float
  unitPrice Float
  total     Float
}

model PurchaseInvoice {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id])

  invoiceNumber String
  status        String    @default("DRAFT")
  issueDate     DateTime  @default(now())
  dueDate       DateTime?

  subtotal    Float
  taxAmount   Float @default(0)
  totalAmount Float

  items    PurchaseInvoiceItem[]
  payments Payment[]

  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  branchId  String?
  branch    Branch?          @relation(fields: [branchId], references: [id])
  returns   PurchaseReturn[]

  @@unique([id, organizationId])
  @@index([organizationId, createdAt(sort: Desc)])
}

model PurchaseInvoiceItem {
  id                String          @id @default(cuid())
  purchaseInvoiceId String
  purchaseInvoice   PurchaseInvoice @relation(fields: [purchaseInvoiceId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id])

  quantity Float
  unitCost Float
  total    Float
}

model FinancialAccount {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name          String
  type          String // CASH, BANK, POS_DRAWER
  accountNumber String?
  bankName      String?

  currentBalance Float   @default(0)
  isDefault      Boolean @default(false)
  isActive       Boolean @default(true)

  payments      Payment[]
  expenses      Expense[]
  ledgerEntries LedgerEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([id, organizationId])
  @@index([organizationId])
}

model LedgerEntry {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  accountId String
  account   FinancialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  amount        Float
  balanceAfter  Float
  description   String
  referenceType String
  referenceId   String

  createdAt DateTime @default(now())

  @@unique([id, organizationId])
  @@index([organizationId])
}

model AuditLog {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  action     String
  entityType String
  entityId   String
  details    String?

  createdAt DateTime @default(now())

  @@unique([id, organizationId])
  @@index([organizationId, createdAt(sort: Desc)])
}

