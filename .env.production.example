# ⚠️ PRODUCTION VPS ENVIRONMENT TEMPLATE (.env)
# Copy this to .env on your VPS and fill in the secrets.

# 1. CORE CONFIGURATION
NODE_ENV="production"
APP_URL="https://yourdomain.com"
NEXT_PUBLIC_APP_URL="https://yourdomain.com"
NEXTAUTH_URL="https://yourdomain.com"
NEXTAUTH_SECRET="REPLACE_WITH_LONG_RANDOM_HASH" # Generate with: openssl rand -base64 32

# 2. DATABASE (PostgreSQL)
DATABASE_URL="postgresql://whatsquery_app:REPLACE_DB_PASSWORD@127.0.0.1:5432/whatsquery_db?schema=public"
DIRECT_URL="postgresql://whatsquery_app:REPLACE_DB_PASSWORD@127.0.0.1:5432/whatsquery_db?schema=public"

# 3. PLATFORM ADMINISTRATION
# Comma-separated list of super admin emails
SUPER_ADMIN_EMAILS="admin@whatsquery.com"

# 4. SECURITY & AUTH
ALLOW_OTP_BYPASS="false" # MUST BE FALSE IN PRODUCTION
ENCRYPTION_KEY="REPLACE_WITH_LONG_RANDOM_SECRET" # Required for encrypting tenant integration credentials
INTEGRATION_CREDENTIAL_SECRET="REPLACE_WITH_LONG_RANDOM_SECRET" # Optional legacy alias if you prefer not to use ENCRYPTION_KEY
ENABLE_DEBUG_ROUTES="false"
SUPER_ADMIN_BOOTSTRAP_PASSWORD="REPLACE_WITH_A_UNIQUE_TEMP_PASSWORD"

# 5. EXTERNAL SERVICES (Optional but Recommended)
EMAIL_PROVIDER="resend"
RESEND_API_KEY="re_..." # For transactional emails
EMAIL_FROM="noreply@yourdomain.com"
REDIS_URL="redis://127.0.0.1:6379"
NEXT_PUBLIC_TURNSTILE_SITE_KEY="1x..." # Cloudflare Turnstile Site Key
TURNSTILE_SECRET_KEY="1x..." # Cloudflare Turnstile Secret Key
WHATSQUERY_BACKUP_RETENTION_DAYS="14"
WHATSQUERY_BACKUP_ALERT_EMAIL="ops@yourdomain.com"
# Optional generic failure alert webhook (Slack/Discord/Teams compatible)
# WHATSQUERY_BACKUP_ALERT_WEBHOOK_URL="https://hooks.example.com/services/..."

# 5c. VOICE SUBDOMAIN FOUNDATION
# Public host served by the same Next.js app. Keep host-scoped auth cookies for safety.
VOICE_APP_HOST="voice.whatsquery.com"
# Public HTTPS URL for the receptionist product.
VOICE_APP_URL="https://voice.whatsquery.com"
# Feature flag only. Set true only when DNS + Nginx + SSL are ready.
VOICE_PRODUCT_ENABLED="true"
# Placeholder only. Keep disabled until real provider work is implemented.
VOICE_TELEPHONY_PROVIDER="disabled"
# Provider placeholders only. Leave blank until you have real credentials.
VOICE_VAPI_API_KEY=""
VOICE_VAPI_ASSISTANT_ID=""
VOICE_VAPI_PHONE_NUMBER_ID=""
VOICE_TWILIO_ACCOUNT_SID=""
VOICE_TWILIO_AUTH_TOKEN=""
VOICE_TWILIO_PHONE_NUMBER=""
VOICE_TWILIO_WEBHOOK_SECRET=""
VOICE_CALENDAR_PROVIDER=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
VOICE_CRM_WEBHOOK_URL=""
VOICE_WHATSAPP_FOLLOW_UP_WEBHOOK_URL=""

# 5b. OFF-SERVER POSTGRESQL BACKUPS (Cloudflare R2)
WHATSQUERY_BACKUP_R2_ENABLED="true"
WHATSQUERY_BACKUP_R2_ACCOUNT_ID="your-cloudflare-account-id"
WHATSQUERY_BACKUP_R2_ENDPOINT="https://your-cloudflare-account-id.r2.cloudflarestorage.com"
WHATSQUERY_BACKUP_R2_BUCKET="whatsquery-backups"
WHATSQUERY_BACKUP_R2_PREFIX="postgres"
WHATSQUERY_BACKUP_R2_REGION="auto"
WHATSQUERY_BACKUP_R2_RETENTION_DAYS="30"
WHATSQUERY_BACKUP_R2_ACCESS_KEY_ID="REPLACE_WITH_R2_ACCESS_KEY_ID"
WHATSQUERY_BACKUP_R2_SECRET_ACCESS_KEY="REPLACE_WITH_R2_SECRET_ACCESS_KEY"

# 6. STRIPE BILLING
STRIPE_SECRET_KEY="sk_live_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_live_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_STARTER_PRICE_ID="price_monthly_starter"
STRIPE_BUSINESS_PRICE_ID="price_monthly_business"
STRIPE_PRO_PRICE_ID="price_monthly_pro"
STRIPE_STARTER_YEARLY_PRICE_ID="price_yearly_starter"
STRIPE_BUSINESS_YEARLY_PRICE_ID="price_yearly_business"
STRIPE_PRO_YEARLY_PRICE_ID="price_yearly_pro"

# 7. STORAGE (Optional)
# STORAGE_TYPE="s3"
# S3_ENDPOINT="https://..."
# S3_ACCESS_KEY="..."
# S3_SECRET_KEY="..."
# S3_BUCKET="whatsquery-uploads"

# 8. OPTIONAL INTEGRATIONS
# SHOPIFY_API_KEY=""
# SHOPIFY_API_SECRET=""
# WOOCOMMERCE_CONSUMER_KEY=""
# WOOCOMMERCE_CONSUMER_SECRET=""
# DARAZ_APP_KEY=""
# DARAZ_APP_SECRET=""
# DARAZ_ACCESS_TOKEN=""
